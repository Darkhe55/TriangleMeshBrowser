{
  "_comment": [
    "签名材料配置。复制本文件为同目录下的 signing.local.json 并填入真实值。",
    "signing.local.json 已被 .gitignore 忽略, 其中的密码不会进入仓库。",
    "本文件供 tools/build_ascii.py 调用 SDK 自带 hap-sign-tool.jar 签名使用。",
    "注意: 请把 <你的 keys 目录> 换成本机存放 .p12/.cer/.p7b 的实际目录。"
  ],
  "keystoreFile": "<你的 keys 目录>/prismviewer.p12",
  "keystorePwd": "<生成 .p12 时设置的密码>",
  "keyAlias": "<你的 keyAlias, 例如 prismviewer_key>",
  "keyPwd": "<密钥密码, PKCS12 下与 keystorePwd 相同>",
  "appCertFile": "<你的 keys 目录>/你的发布证书.cer",
  "profileFile": "<你的 keys 目录>/你的发布Profile.p7b",
  "signAlg": "SHA256withECDSA",
  "compatibleVersion": "12"
}
